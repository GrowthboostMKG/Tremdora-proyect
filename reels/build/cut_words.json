 "blocks": [
  {
   "dst0": 0.3,
   "dur": 4.159979166666667,
   "text": "Si el veterinario te dice que llegó la hora de despedirte de tu mascota,"
  },
  {
   "dst0": 4.779979166666667,
   "dur": 1.619,
   "text": "no salgas de esa sala."
  },
  {
   "dst0": 6.948979166666667,
   "dur": 1.84,
   "text": "Tu presencia lo cambia todo."
  },
  {
   "dst0": 9.438979166666668,
   "dur": 4.4,
   "text": "Cuando el dueño se va, el animal lo busca con la mirada hasta el final."
  },
  {
   "dst0": 14.538979166666667,
   "dur": 4.594,
   "text": "Aunque ya casi no vea, tu voz y tu mano le dicen que está a salvo."
  },
  {
   "dst0": 19.93297916666667,
   "dur": 3.28,
   "text": "Lo más difícil es la culpa que viene después."
  },
  {
   "dst0": 23.96297916666667,
   "dur": 4.72,
   "text": "Si ya tomaste esa decisión, escúchame, no lo abandonaste."
  },
  {
   "dst0": 29.332979166666668,
   "dur": 3.856,
   "text": "Eso no es rendirse. Es el último acto de cuidado."
  },
  {
   "dst0": 33.93897916666667,
   "dur": 1.981,
   "text": "Tú tuviste muchas cosas en tu vida."
  },
  {
   "dst0": 36.33997916666667,
   "dur": 1.747,
   "text": "Él solo te tuvo a ti."
  },
  {
   "dst0": 38.63697916666667,
   "dur": 2.7950208333333335,
   "text": "Fuiste su casa, su mundo entero."
  },
  {
   "dst0": 42.082,
   "dur": 1.053,
   "text": "No le fallaste."
  },
  {
   "dst0": 43.535,
   "dur": 2.3160208333333334,
   "text": "Se fue en los brazos de quien más amaba."
  },
  {
   "dst0": 46.40102083333333,
   "dur": 3.958,
   "text": "Si alguien que conoces está pasando por esto, mándale este video."
  },
  {
   "dst0": 51.009020833333324,
   "dur": 1.9010208333333334,
   "text": "Nadie debería pasar un duelo solo."
  }
 ],
 "voice_end": 52.91004166666666
}